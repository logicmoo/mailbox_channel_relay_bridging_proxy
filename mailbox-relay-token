#!/usr/bin/env sh
set -eu

relay_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
relay_python=python3
if [ -x "$relay_root/.venv/bin/python" ]; then
    relay_python="$relay_root/.venv/bin/python"
fi
export PYTHONPATH="$relay_root/src${PYTHONPATH:+:$PYTHONPATH}"
exec "$relay_python" -m mailbox_channel_relay_bridging_proxy.token_admin "$@"
